# ============================================
# FRONTEND - Vercel Environment Variables
# ============================================

# Backend API URL
NEXT_PUBLIC_API_URL=https://chefex-api.railway.app

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry (opcional - monitoramento de erros)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ============================================
# BACKEND - Railway/Render Environment Variables
# ============================================

# Database
DATABASE_URL=postgresql://user:password@host:5432/chefex_prod?sslmode=require

# Security
SECRET_KEY=your-super-secret-key-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_live_...

# CORS
ALLOWED_ORIGINS=https://chefex.vercel.app,http://localhost:3000

# App Config
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# Email (opcional - para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Storage (opcional - para upload de imagens)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=chefex-uploads
AWS_REGION=us-east-1
